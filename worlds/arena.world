<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="arena">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name='walls'>
      <pose>0 0 0 0 0 0</pose>
      <static>1</static>
      <link name='link'>
        <visual name='wall_1'>
          <pose>0 3 0.5 0 0 0</pose>
          <geometry><box><size>6 0.1 1</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
        <collision name='wall_1_col'>
          <pose>0 3 0.5 0 0 0</pose>
          <geometry><box><size>6 0.1 1</size></box></geometry>
        </collision>

        <visual name='wall_2'>
          <pose>0 -3 0.5 0 0 0</pose>
          <geometry><box><size>6 0.1 1</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
        <collision name='wall_2_col'>
          <pose>0 -3 0.5 0 0 0</pose>
          <geometry><box><size>6 0.1 1</size></box></geometry>
        </collision>

        <visual name='wall_3'>
          <pose>3 0 0.5 0 0 1.57</pose>
          <geometry><box><size>6 0.1 1</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
        <collision name='wall_3_col'>
          <pose>3 0 0.5 0 0 1.57</pose>
          <geometry><box><size>6 0.1 1</size></box></geometry>
        </collision>

        <visual name='wall_4'>
          <pose>-3 0 0.5 0 0 1.57</pose>
          <geometry><box><size>6 0.1 1</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
        <collision name='wall_4_col'>
          <pose>-3 0 0.5 0 0 1.57</pose>
          <geometry><box><size>6 0.1 1</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name='cylinder_obstacle_1'>
      <pose>1.5 1.5 0.5 0 0 0</pose>
      <static>1</static>
      <link name='link'>
        <visual name='visual'>
          <geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.8 0 0 1</ambient><diffuse>0.8 0 0 1</diffuse></material>
        </visual>
        <collision name='collision'>
          <geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry>
        </collision>
      </link>
    </model>

    <model name='box_obstacle_2'>
      <pose>-1.5 -1.0 0.5 0 0 0</pose>
      <static>1</static>
      <link name='link'>
        <visual name='visual'>
          <geometry><box><size>0.5 0.5 1.0</size></box></geometry>
          <material><ambient>0 0 0.8 1</ambient><diffuse>0 0 0.8 1</diffuse></material>
        </visual>
        <collision name='collision'>
          <geometry><box><size>0.5 0.5 1.0</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name='box_obstacle_3'>
      <pose>-1.5 1.75 0.5 0 0 0</pose>
      <static>1</static>
      <link name='link'>
        <visual name='visual'>
          <geometry><box><size>0.5 0.5 1.0</size></box></geometry>
          <material><ambient>0 0 0.8 1</ambient><diffuse>0 0 0.8 1</diffuse></material>
        </visual>
        <collision name='collision'>
          <geometry><box><size>0.5 0.5 1.0</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name='cylinder_obstacle_2'>
      <pose>1.5 -2.0 0.5 0 0 0</pose>
      <static>1</static>
      <link name='link'>
        <visual name='visual'>
          <geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.8 0 0 1</ambient><diffuse>0.8 0 0 1</diffuse></material>
        </visual>
        <collision name='collision'>
          <geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry>
        </collision>
      </link>
    </model>

  </world>
</sdf>
